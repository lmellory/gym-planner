# Скопируй в .dev.vars для локального запуска (wrangler dev). В git не попадёт.
BOT_TOKEN=123456:ABC-your-token
WEBHOOK_SECRET=any-random-string
# Администраторы (Telegram ID через запятую). Доступ тренерам выдаёт администратор командой /adduser.
ADMIN_ID=123456789
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token
